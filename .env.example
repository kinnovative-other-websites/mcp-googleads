# Copy to .env and fill in. Keep comments on their own lines (no inline comments).

# Public HTTPS origin of this server, no path. Claude connects to <PUBLIC_BASE_URL>/mcp
PUBLIC_BASE_URL=https://ads-mcp.example.com

# OAuth client of type "Web application", created in the Google Cloud project that has
# Google Ads API access. Authorized redirect URI: <PUBLIC_BASE_URL>/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Random secret that encrypts all tokens. Generate with: openssl rand -base64 48
# Changing it signs everyone out.
MCP_AUTH_SECRET=

# Who may sign in, comma-separated. Set at least one of the two.
ALLOWED_EMAILS=you@example.com
ALLOWED_EMAIL_DOMAINS=

# Manager (MCC) account ID, if you reach your ad accounts through one. Example: 123-456-7890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Account to use when Claude does not name one. Example: 123-456-7890
GOOGLE_ADS_DEFAULT_CUSTOMER_ID=

# Google Ads API version. Check queries first with: npm run check:gaql -- v27
GOOGLE_ADS_API_VERSION=v26

# Optional. Google ignores developer tokens since 2026-09-09; it is sent only if set.
# GOOGLE_ADS_DEVELOPER_TOKEN=

# Optional tuning
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_DAYS=90
# MAX_ROWS=1000
# TRUST_PROXY=loopback, linklocal, uniquelocal
# EXTRA_REDIRECT_URIS=
